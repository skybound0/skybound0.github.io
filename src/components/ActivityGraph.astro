---
import type { CollectionEntry } from 'astro:content';

interface Props {
  activities: CollectionEntry<'activities'>[];
  title?: string;
}

const { activities, title } = Astro.props;

const MONTH_MAP: Record<string, number> = {
  jan: 0,
  january: 0,
  feb: 1,
  february: 1,
  mar: 2,
  march: 2,
  apr: 3,
  april: 3,
  may: 4,
  jun: 5,
  june: 5,
  jul: 6,
  july: 6,
  aug: 7,
  august: 7,
  sep: 8,
  sept: 8,
  september: 8,
  oct: 9,
  october: 9,
  nov: 10,
  november: 10,
  dec: 11,
  december: 11,
};

function parseDateToken(rawToken: string): number {
  const token = rawToken.trim().toLowerCase();

  if (!token) return Number.NEGATIVE_INFINITY;
  if (token.includes('present') || token.includes('current') || token.includes('now')) return Date.now();

  const monthYearMatch = token.match(/([a-z]+)\s+(\d{4})/i);
  if (monthYearMatch) {
    const month = MONTH_MAP[monthYearMatch[1].toLowerCase()];
    const year = Number(monthYearMatch[2]);
    if (!Number.isNaN(month) && !Number.isNaN(year)) return new Date(year, month, 1).getTime();
  }

  const yearMatch = token.match(/\b(19|20)\d{2}\b/);
  return yearMatch ? new Date(Number(yearMatch[0]), 0, 1).getTime() : Number.NEGATIVE_INFINITY;
}

function getRecencyScore(dateText: string): number {
  const parts = dateText
    .replace(/\u2013/g, '-')
    .split('-')
    .map((part) => part.trim())
    .filter(Boolean);

  if (parts.length === 0) return Number.NEGATIVE_INFINITY;
  return parseDateToken(parts[parts.length - 1]) || parseDateToken(parts[0]);
}

function getInitials(name: string): string {
  const words = name.trim().split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return `${words[0][0]}${words[words.length - 1][0]}`.toUpperCase();
}

function getSeededUnit(seed: string): number {
  let hash = 2166136261;
  for (let characterIndex = 0; characterIndex < seed.length; characterIndex += 1) {
    hash ^= seed.charCodeAt(characterIndex);
    hash = Math.imul(hash, 16777619);
  }
  return (hash >>> 0) / 4294967295;
}

const activitiesSorted = [...activities].sort((firstActivity, secondActivity) => getRecencyScore(secondActivity.data.date) - getRecencyScore(firstActivity.data.date));
const GOLDEN_ANGLE = Math.PI * (3 - Math.sqrt(5));
const ICON_LAYOUT_SEED = 'hello-biden';
const total = Math.max(1, activitiesSorted.length);
const INNER_RADIUS_PCT = 8;
const OUTER_RADIUS_PCT = 34;
const COLLISION_PADDING_PCT = 5;
const COLLISION_ITERATIONS = 280;
const CENTER_PULL = 0.001;

type NodeLayout = {
  activity: CollectionEntry<'activities'>;
  xPct: number;
  yPct: number;
  sizePct: number;
  initials: string;
  zIndex: number;
};

const nodes: NodeLayout[] = activitiesSorted.map((activity, index) => {
  const recencyWeight = total <= 1 ? 1 : 1 - index / (total - 1);
  const seedBase = `${ICON_LAYOUT_SEED}-${activity.id}-${activity.data.organization}-${index}`;
  const angle = -Math.PI / 2 + index * GOLDEN_ANGLE + (getSeededUnit(`${seedBase}-angle`) - 0.5) * 0.95;
  const radiusJitter = (getSeededUnit(`${seedBase}-radius`) - 0.5) * 5.5;
  const spiralRadius = Math.sqrt((index + 0.5) / total) * (OUTER_RADIUS_PCT - INNER_RADIUS_PCT);
  const radius = Math.max(INNER_RADIUS_PCT, Math.min(OUTER_RADIUS_PCT, INNER_RADIUS_PCT + spiralRadius + radiusJitter + (1 - recencyWeight) * 2.2));

  return {
    activity,
    xPct: 50 + Math.cos(angle) * radius,
    yPct: 50 + Math.sin(angle) * radius,
    sizePct: 16 + recencyWeight * 15,
    initials: getInitials(activity.data.organization),
    zIndex: 10 + Math.round(recencyWeight * 80),
  };
});

for (let iteration = 0; iteration < COLLISION_ITERATIONS; iteration += 1) {
  for (let firstIndex = 0; firstIndex < nodes.length; firstIndex += 1) {
    for (let secondIndex = firstIndex + 1; secondIndex < nodes.length; secondIndex += 1) {
      const firstNode = nodes[firstIndex];
      const secondNode = nodes[secondIndex];
      const deltaX = secondNode.xPct - firstNode.xPct;
      const deltaY = secondNode.yPct - firstNode.yPct;
      const distance = Math.hypot(deltaX, deltaY) || 0.001;
      const minimumDistance = (firstNode.sizePct + secondNode.sizePct) / 2 + COLLISION_PADDING_PCT;

      if (distance < minimumDistance) {
        const overlap = (minimumDistance - distance) / 2;
        const unitX = deltaX / distance;
        const unitY = deltaY / distance;
        firstNode.xPct -= unitX * overlap;
        firstNode.yPct -= unitY * overlap;
        secondNode.xPct += unitX * overlap;
        secondNode.yPct += unitY * overlap;
      }
    }
  }

  for (const node of nodes) {
    node.xPct += (50 - node.xPct) * CENTER_PULL;
    node.yPct += (50 - node.yPct) * CENTER_PULL;
    const edgeInset = node.sizePct / 2 + 0.35;
    node.xPct = Math.min(100 - edgeInset, Math.max(edgeInset, node.xPct));
    node.yPct = Math.min(100 - edgeInset, Math.max(edgeInset, node.yPct));
  }
}

for (const node of nodes) {
  const edgeInset = node.sizePct / 2 + 0.35;
  node.xPct = Math.min(100 - edgeInset, Math.max(edgeInset, node.xPct));
  node.yPct = Math.min(100 - edgeInset, Math.max(edgeInset, node.yPct));
}
---

<div class="activity-graph-shell" data-title-graph>
  {nodes.length > 0 ? (
    <div class="activity-graph" role="list" aria-label="Activities graph">
      {title && <h1 class="activity-graph-title" data-activity-title>{title}</h1>}
      {nodes.map((node) => {
        const { data } = node.activity;
        const horizontalClass = node.xPct > 72 ? 'tooltip-left' : node.xPct < 28 ? 'tooltip-right' : 'tooltip-center';
        const verticalClass = node.yPct > 70 ? 'tooltip-up' : 'tooltip-down';

        return (
          <a
            href={data.website}
            target="_blank"
            rel="noopener noreferrer"
            class="activity-node group"
            data-activity-node
            role="listitem"
            title={`${data.organization} - ${data.role}`}
            style={`left:${node.xPct}%; top:${node.yPct}%; --node-size:${node.sizePct}%; --node-z:${node.zIndex};`}
            aria-label={`${data.organization}: ${data.role} (${data.date})`}
          >
            <span class="node-core">
              {data.logo ? (
                <img
                  src={data.logo}
                  alt={data.logoAlt ?? `${data.organization} logo`}
                  class="h-full w-full object-contain rounded-none"
                  loading="lazy"
                />
              ) : (
                <span class="node-fallback glass">{node.initials}</span>
              )}
            </span>

            <span class={`node-tooltip ${horizontalClass} ${verticalClass}`} role="presentation">
              <strong class="block text-sm leading-tight text-foreground">{data.organization}</strong>
              <span class="mt-1 block text-xs text-foreground">{data.role}</span>
              <span class="mt-1 block text-[11px] text-muted-foreground">{data.date}</span>
              {data.notes && data.notes.length > 0 && (
                <ul class="mt-2 space-y-1 text-[11px] leading-snug text-muted-foreground">
                  {data.notes.map((note) => <li>{note}</li>)}
                </ul>
              )}
            </span>
          </a>
        );
      })}
    </div>
  ) : (
    <p class="text-muted-foreground">No activities loaded yet.</p>
  )}
</div>

<style>
  .activity-graph-shell {
    position: relative;
    width: min(100%, 36rem);
    margin: 0 auto;
    overflow: visible;
  }

  .activity-graph {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    min-height: clamp(20rem, 48vw, 34rem);
  }

  .activity-graph-title {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 110;
    margin: 0;
    color: oklch(42% 0.09 250);
    font-size: clamp(3.75rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .activity-node {
    position: absolute;
    transform: translate(-50%, -50%);
    width: var(--node-size);
    height: var(--node-size);
    max-width: 9rem;
    max-height: 9rem;
    min-width: 4rem;
    min-height: 4rem;
    z-index: var(--node-z);
    display: grid;
    place-items: center;
  }

  .activity-node:hover,
  .activity-node:focus-visible {
    z-index: 300;
  }

  .node-core {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    transition: transform 180ms ease;
  }

  .activity-node:hover .node-core,
  .activity-node:focus-visible .node-core {
    transform: scale(1.08);
  }

  .node-fallback {
    width: 100%;
    height: 100%;
    border-radius: 0.5rem;
    display: grid;
    place-items: center;
    font-size: clamp(0.72rem, 0.52rem + 0.45vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: oklch(24% 0.025 248);
  }

  .node-tooltip {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    width: max-content;
    max-width: min(15rem, 70vw);
    padding: 0.65rem 0.8rem;
    border: 1px solid oklch(70% 0.025 248);
    border-radius: 0.5rem;
    background: oklch(96% 0.012 248);
    transform: translate(-50%, 0.35rem);
    pointer-events: none;
    opacity: 0;
    transition: opacity 160ms ease, transform 160ms ease;
    text-align: left;
  }

  .node-tooltip.tooltip-left { left: auto; right: calc(100% + 0.6rem); transform: translate(0.35rem, 0); }
  .node-tooltip.tooltip-right { left: calc(100% + 0.6rem); transform: translate(-0.35rem, 0); }
  .node-tooltip.tooltip-up { top: auto; bottom: calc(100% + 0.6rem); }

  .activity-node:hover .node-tooltip,
  .activity-node:focus-visible .node-tooltip {
    z-index: 400;
    opacity: 1;
    transform: translate(0, 0);
  }

  .activity-node:hover .node-tooltip.tooltip-center,
  .activity-node:focus-visible .node-tooltip.tooltip-center {
    transform: translate(-50%, 0);
  }

  @media (max-width: 640px) {
    .activity-graph-shell { width: min(100%, 24rem); }
    .activity-graph { min-height: 20rem; }
    .node-tooltip { max-width: min(12rem, 62vw); }
  }
</style>

<script>
  const titleGraphs = document.querySelectorAll<HTMLElement>('[data-title-graph]');

  function arrangeAroundTitle(graph: HTMLElement) {
    const title = graph.querySelector<HTMLElement>('[data-activity-title]');
    const nodes = [...graph.querySelectorAll<HTMLElement>('[data-activity-node]')];
    if (!title || nodes.length === 0) return;

    const margin = 64;
    const iconGap = 32;
    const graphRect = graph.getBoundingClientRect();
    const titleRect = title.getBoundingClientRect();
    const keepout = {
      left: titleRect.left - graphRect.left - margin,
      right: titleRect.right - graphRect.left + margin,
      top: titleRect.top - graphRect.top - margin,
      bottom: titleRect.bottom - graphRect.top + margin,
    };

    for (let pass = 0; pass < 8; pass += 1) {
      let moved = false;

      for (const node of nodes) {
        const nodeRect = node.getBoundingClientRect();
        const relativeNode = {
          left: nodeRect.left - graphRect.left,
          right: nodeRect.right - graphRect.left,
          top: nodeRect.top - graphRect.top,
          bottom: nodeRect.bottom - graphRect.top,
        };
        const overlaps = relativeNode.right > keepout.left && relativeNode.left < keepout.right && relativeNode.bottom > keepout.top && relativeNode.top < keepout.bottom;

        if (!overlaps) continue;

        const moveLeft = keepout.left - relativeNode.right;
        const moveRight = keepout.right - relativeNode.left;
        const moveUp = keepout.top - relativeNode.bottom;
        const moveDown = keepout.bottom - relativeNode.top;
        const horizontalMove = Math.abs(moveLeft) < Math.abs(moveRight) ? moveLeft : moveRight;
        const verticalMove = Math.abs(moveUp) < Math.abs(moveDown) ? moveUp : moveDown;
        const moveX = Math.abs(horizontalMove) < Math.abs(verticalMove) ? horizontalMove : 0;
        const moveY = moveX === 0 ? verticalMove : 0;
        const left = Number.parseFloat(node.style.left) || 50;
        const top = Number.parseFloat(node.style.top) || 50;

        node.style.left = `${left + (moveX / graphRect.width) * 100}%`;
        node.style.top = `${top + (moveY / graphRect.height) * 100}%`;
        moved = true;
      }

      for (let firstIndex = 0; firstIndex < nodes.length; firstIndex += 1) {
        const firstNode = nodes[firstIndex].getBoundingClientRect();
        const firstCenterX = firstNode.left + firstNode.width / 2;
        const firstCenterY = firstNode.top + firstNode.height / 2;

        for (let secondIndex = firstIndex + 1; secondIndex < nodes.length; secondIndex += 1) {
          const secondNode = nodes[secondIndex].getBoundingClientRect();
          const overlapX = (firstNode.width + secondNode.width) / 2 + iconGap - Math.abs(secondNode.left + secondNode.width / 2 - firstCenterX);
          const overlapY = (firstNode.height + secondNode.height) / 2 + iconGap - Math.abs(secondNode.top + secondNode.height / 2 - firstCenterY);

          if (overlapX <= 0 || overlapY <= 0) continue;

          const secondLeft = Number.parseFloat(nodes[secondIndex].style.left) || 50;
          const secondTop = Number.parseFloat(nodes[secondIndex].style.top) || 50;
          const secondCenterX = secondNode.left + secondNode.width / 2;
          const secondCenterY = secondNode.top + secondNode.height / 2;

          if (overlapX < overlapY) {
            const direction = secondCenterX >= firstCenterX ? 1 : -1;
            nodes[secondIndex].style.left = `${secondLeft + (direction * overlapX / graphRect.width) * 100}%`;
          } else {
            const direction = secondCenterY >= firstCenterY ? 1 : -1;
            nodes[secondIndex].style.top = `${secondTop + (direction * overlapY / graphRect.height) * 100}%`;
          }

          moved = true;
        }
      }

      if (!moved) break;
    }
  }

  for (const graph of titleGraphs) {
    requestAnimationFrame(() => arrangeAroundTitle(graph));
    const observer = new ResizeObserver(() => arrangeAroundTitle(graph));
    observer.observe(graph);
  }
</script>
