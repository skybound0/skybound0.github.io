---
import { getDimensionsFromAspectRatio } from '../lib/image';
import CategoryList from './CategoryList.astro';

export type ProjectCardData = {
	title: string;
	slug: string;
	date: string;
	description?: string;
	image?: string;
	imageAspectRatio?: string;
	categories: string[];
};

interface Props {
	project: ProjectCardData;
	index: number;
}

const { project, index } = Astro.props;
const href = `/projects/${project.slug}`;
const imageDimensions = getDimensionsFromAspectRatio(project.imageAspectRatio, 1400);
---

<article class="card group relative bg-base-200 transition-colors duration-200 hover:bg-base-300">
	{project.image && (
		<figure
			class="relative w-full overflow-hidden rounded-t-box bg-base-300"
			style={{ aspectRatio: project.imageAspectRatio || '16 / 9' }}
		>
			<img
				src={project.image}
				alt=""
				width={imageDimensions.width}
				height={imageDimensions.height}
				loading={index === 0 ? 'eager' : 'lazy'}
				decoding="async"
				fetchpriority={index === 0 ? 'high' : 'auto'}
				sizes="(max-width: 1024px) 100vw, 500px"
				class="h-full w-full object-cover"
			/>
		</figure>
	)}

	<div class="card-body gap-3 p-5">
		<p class="meta">{project.date}</p>
		<h2 class="card-title text-xl font-bold leading-tight">
			<a href={href} class="after:absolute after:inset-0 after:rounded-box group-hover:text-primary">
				{project.title}
			</a>
		</h2>

		{project.description && (
			<p class="text-sm leading-relaxed text-base-content/70">{project.description}</p>
		)}

		<CategoryList categories={project.categories} class="mt-2" onTint />
	</div>
</article>
