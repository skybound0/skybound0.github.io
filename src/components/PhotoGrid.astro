---
import { getDimensionsFromAspectRatio } from '../lib/image';

export interface Photo {
  src: string;
  caption: string;
  aspectRatio?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<div class="photo-grid">
  {photos.map((photo, index) => {
    const imageDimensions = getDimensionsFromAspectRatio(photo.aspectRatio, 1000, '1 / 1');

    return (
      <figure class="photo relative overflow-hidden rounded-box bg-base-200" tabindex="0" style={{ aspectRatio: photo.aspectRatio || '1 / 1' }}>
        <img
          src={photo.src}
          alt={photo.caption}
          width={imageDimensions.width}
          height={imageDimensions.height}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={index === 0 ? 'high' : 'auto'}
          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
          class="block h-full w-full object-cover"
        />
        <figcaption class="photo-caption absolute inset-x-0 bottom-0 bg-base-100/90 px-4 py-3 text-sm font-medium leading-snug text-base-content">
          {photo.caption}
        </figcaption>
      </figure>
    );
  })}
</div>

<style>
  .photo-grid {
    column-count: 1;
    column-gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .photo-grid {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .photo-grid {
      column-count: 3;
    }
  }

  .photo {
    break-inside: avoid;
    margin: 0 0 1.5rem;
    outline: none;
  }

  .photo:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .photo-caption {
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .photo:hover .photo-caption,
  .photo:focus-within .photo-caption {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: none) {
    .photo-caption {
      opacity: 1;
      transform: none;
    }
  }
</style>
