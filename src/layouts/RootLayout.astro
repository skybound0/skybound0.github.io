---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Eric Gu', description = 'Projects, cooking, and more' } =
	Astro.props;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="shortcut icon" href="/favicon.ico" />
	<body>
		{!isHome && <nav
			class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-background"
		>
			<div class="container mx-auto px-4 py-3 sm:py-4 flex items-center justify-center">
				{/* Desktop Navigation */}
				<div class="hidden sm:flex items-center gap-1">
					<a
						href="/"
						class="px-4 py-2 text-sm font-medium rounded-md text-muted-foreground hover:text-foreground hover:bg-muted"
					>
						Home
					</a>
					<a
						href="/projects"
						class="px-4 py-2 text-sm font-medium rounded-md text-muted-foreground hover:text-foreground hover:bg-muted"
					>
						Projects
					</a>
					<a
						href="/cooking"
						class="px-4 py-2 text-sm font-medium rounded-md text-muted-foreground hover:text-foreground hover:bg-muted"
					>
						Cooking
					</a>
				</div>

				{/* Mobile Navigation */}
				<div class="sm:hidden flex items-center justify-center gap-4 text-sm">
					<a href="/" class="text-muted-foreground hover:text-foreground">
						Home
					</a>
					<a href="/projects" class="text-muted-foreground hover:text-foreground">
						Projects
					</a>
					<a href="/cooking" class="text-muted-foreground hover:text-foreground">
						Cooking
					</a>
				</div>
			</div>
		</nav>}

		<main class={isHome ? '' : 'pt-20'}>
			<slot />
		</main>

		{/* Footer */}
		<footer
			class="border-t border-border bg-background mt-16"
		>
			<div class="container mx-auto px-4 py-6">
				<div class="flex items-center justify-center gap-8 text-base text-muted-foreground">
					<div class="text-center">© 2025 Eric Gu</div>
				</div>
			</div>
		</footer>
	</body>
</html>
