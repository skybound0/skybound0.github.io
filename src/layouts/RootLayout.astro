---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Eric Gu', description = 'Projects, cooking, and more' } =
	Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';

const navItems = [
	{ href: '/projects', label: 'Projects' },
	{ href: '/cooking', label: 'Cooking' },
	{ href: '/shares', label: 'Shares' },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en" data-theme="skybound">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="shortcut icon" href="/favicon.ico" />
	</head>
	<body class="flex min-h-screen flex-col">
		{!isHome && (
			<header class="sticky top-0 z-50 bg-base-100">
				<nav class="navbar mx-auto min-h-14 py-0 max-w-5xl px-5 sm:px-8" aria-label="Main navigation">
					<div class="flex-1">
						<a href="/" class="text-base font-bold tracking-tight hover:text-primary">
							Eric Gu
						</a>
					</div>
					<ul class="flex items-center gap-1 sm:gap-2">
						{navItems.map((item) => (
							<li>
								<a
									href={item.href}
									class:list={[
										'inline-flex h-14 items-center border-b-2 px-2 sm:px-3 text-sm font-medium transition-colors',
										isActive(item.href)
											? 'border-primary text-primary'
											: 'border-transparent text-base-content/70 hover:text-base-content',
									]}
									aria-current={isActive(item.href) ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</header>
		)}

		<main class="flex-1">
			<slot />
		</main>

		<footer class="bg-base-100">
			<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-6 sm:px-8">
				<span class="meta">© 2025 Eric Gu</span>
				<a href="#" class="meta hover:text-primary">Top ↑</a>
			</div>
		</footer>
	</body>
</html>
