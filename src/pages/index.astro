---
import RootLayout from '../layouts/RootLayout.astro';
import { buttonVariants } from '../components/ui/Button';
import { getCollection } from 'astro:content';
import ActivityGraph from '../components/ActivityGraph.astro';

const activities = await getCollection('activities');
const buddyBox = await getCollection('buddyBox');
const buddyBoxData = buddyBox[0]?.data;
---

<RootLayout title="Eric Gu" description="Projects, cooking, and more">
  <div class="page-container-home">
    <section class="home-activity-stage">
      <h2 class="sr-only">What I'm Involved In</h2>
      <ActivityGraph activities={activities} title="Hi! :)" />
    </section>

    <section class="home-intro">
      <div class="home-intro-copy">
        <p>I'm Eric, a junior at UC Berkeley double majoring in mechanical engineering and electrical engineering & computer science (EECS). I enjoy all things mechatronics, including robots, drones, and 3D printers. When I'm not locked away in Etcheverry Hall, Supernode, or the Open Computing Facility, you can find me baking, biking, building random stuff, and working on my homelab.</p>
      </div>
      <nav class="home-intro-nav" aria-label="Main navigation">
        <a href="/projects" class={buttonVariants({ variant: 'project' })}>Projects</a>
        <a href="/cooking" class={buttonVariants({ variant: 'outline' })}>Cooking</a>
        <a href="/Gu_Eric_Resume_8_1_2026.pdf" target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: 'outline' })}>Resume</a>
      </nav>
    </section>

    <section class="mt-16">
      {buddyBoxData ? (
        <>
          <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-5">
            {buddyBoxData.items.map((item) => (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center transition-opacity hover:opacity-90"
                aria-label={item.alt}
                title={item.alt}
              >
                <div class="w-[158px] sm:w-[176px]" style="aspect-ratio: 88 / 31;">
                  <img
                    src={item.image}
                    alt={item.alt}
                    style={{ imageRendering: 'pixelated', borderRadius: '0' }}
                    width="176"
                    height="62"
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 640px) 158px, 176px"
                    class="w-full h-full object-contain"
                  />
                </div>
              </a>
            ))}
          </div>
        </>
      ) : (
        <p class="text-muted-foreground">Add buddy box content in src/content/buddy-box/index.md</p>
      )}
    </section>
  </div>
</RootLayout>

<style>
  .home-activity-stage {
    position: relative;
    width: 100vw;
    max-width: none;
    min-height: calc(100vh - 3rem);
    min-height: calc(100svh - 3rem);
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .home-activity-stage :global(.activity-graph-shell) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(calc(100% - 2rem), 36rem);
    transform: translate(-50%, -50%);
  }

  .home-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    border-top: 1px solid oklch(58% 0.025 248);
    padding: 3rem 0;
  }

  .home-intro-copy {
    max-width: 42rem;
    color: oklch(38% 0.025 248);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .home-intro-nav {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .home-activity-stage :global(.activity-graph-shell) {
      width: min(calc(100% - 1rem), 24rem);
    }

    .home-intro {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }

    .home-intro-nav {
      justify-content: flex-start;
    }
  }
</style>
