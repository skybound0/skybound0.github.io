---
import RootLayout from "../layouts/RootLayout.astro";
import { getCollection } from "astro:content";
import ActivityGraph from "../components/ActivityGraph.astro";

const activities = await getCollection("activities");
const buddyBox = await getCollection("buddyBox");
const buddyBoxData = buddyBox[0]?.data;

const links = [
  { href: "/projects", label: "Projects", primary: true },
  { href: "/cooking", label: "Cooking" },
  { href: "/shares", label: "Shares" },
  { href: "/shares/Gu_Eric_Resume_8_1_2026.pdf", label: "Resume", external: true },
];
---

<RootLayout title="Eric Gu" description="Projects, cooking, and more">
  <section class="home-activity-stage">
    <h2 class="sr-only">What I'm Involved In</h2>
    <ActivityGraph activities={activities} title="Hi! :)" />
    <button
      type="button"
      class="home-scroll-button btn btn-ghost btn-square btn-lg text-base-content/60 hover:text-primary"
      aria-label="Scroll to description"
      onclick="document.getElementById('home-intro')?.scrollIntoView({ behavior: 'smooth' })"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
        <path d="M5 9l7 7 7-7" />
      </svg>
    </button>
  </section>

  <div class="page-container-home">
    <section id="home-intro" class="grid scroll-mt-8 gap-6 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-8">
        <p class="text-lg leading-relaxed text-base-content/80">
          I'm Eric, a junior at UC Berkeley double majoring in mechanical
          engineering and electrical engineering & computer science (EECS). I
          enjoy all things mechatronics, including robots, drones, and 3D
          printers. When I'm not locked away in Etcheverry Hall, Supernode, the UAVs lab, or
          the Open Computing Facility, you can find me baking, biking, building
          random stuff, and working on my homelab. I also like experimenting
          with photography and digital art, though I'm not very good at either.
        </p>
      </div>
      <nav class="flex flex-wrap gap-2 md:col-span-4 md:flex-col md:items-stretch" aria-label="Main navigation">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "btn justify-between gap-6 font-semibold",
              link.primary ? "btn-primary" : "btn-soft btn-primary",
            ]}
            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {link.label}
            <span aria-hidden="true">{link.external ? "↗" : "→"}</span>
          </a>
        ))}
      </nav>
    </section>

    <section class="mt-20">
      {
        buddyBoxData ? (
          <div class="flex flex-wrap items-center justify-center gap-3">
            {buddyBoxData.items.map((item) => (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex transition-opacity hover:opacity-80"
                aria-label={item.alt}
                title={item.alt}
              >
                <div class="w-[158px] sm:w-[176px]" style="aspect-ratio: 88 / 31;">
                  <img
                    src={item.image}
                    alt={item.alt}
                    style={{ imageRendering: "pixelated" }}
                    width="176"
                    height="62"
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 640px) 158px, 176px"
                    class="h-full w-full object-contain"
                  />
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-center text-base-content/60">
            fwiends
          </p>
        )
      }
    </section>
  </div>
</RootLayout>

<style>
  .home-activity-stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 100vh;
    height: 100svh;
    min-height: 26rem;
    padding: 4.5rem 1rem;
  }

  .home-activity-stage :global(.activity-graph-shell) {
    width: min(100%, calc((100svh - 9rem) * 0.8), 52rem);
    min-width: 17rem;
  }

  @media (orientation: portrait) {
    .home-activity-stage :global(.activity-graph-shell) {
      width: min(100%, calc((100svh - 9rem) * 2 / 3), 64rem);
    }
  }

  .home-scroll-button {
    position: absolute;
    bottom: max(1rem, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
  }

  .home-scroll-button:hover,
  .home-scroll-button:focus-visible {
    transform: translate(-50%, 0.15rem);
  }
</style>
