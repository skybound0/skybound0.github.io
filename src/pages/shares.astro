---
import RootLayout from '../layouts/RootLayout.astro';

const presentationShares = [
	{
		title: 'Machine-Learned Electrodes and Reusable Smartwatch Potentiostat for Cystic Fibrosis Screening',
		description: 'Gulf Coast Undergrauate Research Symposium 2026',
		file: '/shares/presentations/gu_sweat_sensing_squashed.pdf',
	},
	{
		title: 'Why Mario Party is an Allegory for Late-Stage Capitalism',
		description: 'OCF Retreat Spring 2026',
		file: '/shares/presentations/Why%20Mario%20Party%20is%20an%20Allegory%20for%20Late-Stage%20Capitalism.pdf',
	},
	{
		title: 'Rail Transit in Greater Tokyo',
		description: 'Transit! DeCal Final Project',
		file: '/shares/presentations/Rail%20Transit%20in%20Greater%20Tokyo.pdf',
	},
];

const stickerPackImages = [
	'croads.png',
	'croads2.png',
	'croads3.png',
	'buffalo_chicken.png',
	'cereal.png',
	'cereal2.png',
	'feedback.png',
	'oppenheimer_cafe3.png',
	'oppenheimer_croads.png',
	'tier_list.png',
	'variety.png',
];

const signalLink =
	'https://signal.art/addstickers/#pack_id=0746a218f9230c96ee6f2adeb3dfe80e&pack_key=26115bcfc60a8e508d478af8e1a21abace603c87f7fc95d253ff4f51d198a111';
---

<RootLayout title="Shares | Eric Gu" description="Things I have made and shared">
	<div class="page-container">
		<header class="page-header">
			<h1 class="page-title">Shares</h1>
			<p class="page-subtitle">A somewhat disorganized assortment of stuff...</p>
		</header>

		<div class="flex flex-col gap-6">
			<section class="share-section">
				<article class="card w-full bg-base-200">
					<div class="card-body flex-row flex-wrap items-center justify-between gap-6 p-6">
						<div>
							<h3 class="card-title text-xl font-bold">88x31 Button</h3>
							<p class="mt-1 text-base-content/70">:)</p>
						</div>
						<img
							src="/shares/88x31.png"
							alt="Eric Gu 88x31 button"
							width="88"
							height="31"
							loading="lazy"
							decoding="async"
							class="w-44 [image-rendering:pixelated]"
						/>
					</div>
				</article>
			</section>

			<section class="share-section">
				<div class="flex flex-col gap-6">
					{presentationShares.map((share) => (
						<article class="card w-full bg-base-200">
							<div class="card-body grid gap-6 p-6 md:grid-cols-12">
								<div class="md:col-span-5">
									<h3 class="text-xl font-bold leading-tight">{share.title}</h3>
									<p class="mt-2 text-base-content/70">{share.description}</p>
									<a href={share.file} target="_blank" rel="noopener noreferrer" class="btn btn-sm mt-4 border-0 bg-base-100 text-primary hover:bg-primary hover:text-primary-content">
										Open PDF ↗
									</a>
								</div>
								<iframe
									src={share.file}
									title={share.title}
									loading="lazy"
									class="h-64 w-full rounded-field bg-base-300 md:col-span-7"
								></iframe>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="share-section">
				<article class="card w-full bg-base-200">
					<div class="card-body gap-0 p-0">
						<div class="flex flex-wrap items-center justify-between gap-6 p-6">
							<div>
								<h3 class="card-title text-xl font-bold">Berkeley Dining</h3>
								<a href={signalLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm mt-4">
									Add to Signal ↗
								</a>
							</div>
							<img
								src="/shares/packs/berkeley-dining/croads.webp"
								alt="Berkeley Dining sticker"
								width="400"
								height="400"
								loading="lazy"
								decoding="async"
								class="size-32 object-contain"
							/>
						</div>
						<details class="collapse collapse-arrow rounded-none rounded-b-box">
							<summary class="collapse-title font-semibold text-primary">Show pack</summary>
							<div class="collapse-content">
								<div class="grid grid-cols-[repeat(auto-fill,minmax(7rem,1fr))] gap-4">
									{stickerPackImages.map((image) => (
										<img
											src={`/shares/packs/berkeley-dining/${image.replace(/\.[^.]+$/, '.webp')}`}
											alt=""
											loading="lazy"
											class="aspect-square w-full object-contain"
										/>
									))}
								</div>
							</div>
						</details>
					</div>
				</article>
			</section>
		</div>
	</div>
</RootLayout>

<style>
	.share-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
</style>
