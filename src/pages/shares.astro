---
import RootLayout from '../layouts/RootLayout.astro';

const presentationShares = [
	{
		title: 'Machine-Learned Electrodes and Reusable Smartwatch Potentiostat for Cystic Fibrosis Screening',
		description: 'Gulf Coast Undergrauate Research Symposium 2026',
		file: '/shares/presentations/gu_sweat_sensing_squashed.pdf',
	},
    {
		title: 'Why Mario Party is an Allegory for Late-Stage Capitalism',
		description: 'OCF Retreat Spring 2026',
		file: '/shares/presentations/Why%20Mario%20Party%20is%20an%20Allegory%20for%20Late-Stage%20Capitalism.pdf',
	},
    {
		title: 'Rail Transit in Greater Tokyo',
		description: 'Transit! DeCal Final Project',
		file: '/shares/presentations/Rail%20Transit%20in%20Greater%20Tokyo.pdf',
	},
];

const stickerPackImages = [
	'croads.png',
	'croads2.png',
	'croads3.png',
    'buffalo_chicken.png',
	'cereal.png',
	'cereal2.png',
	'feedback.png',
	'oppenheimer_cafe3.png',
	'oppenheimer_croads.png',
	'tier_list.png',
	'variety.png',
];
---

<RootLayout title="Shares | Eric Gu" description="Things I have made and shared">
	<div class="page-container-wide">
		<h1 class="page-title">Shares</h1>
		<p class="page-subtitle">A somewhat disorganized assortment of stuff...</p>

		<div class="share-list">
			<article class="share-card share-card-image">
				<div class="share-card-copy">
					<h2 class="share-title">88x31 Button</h2>
					<p class="share-description">
						My 88x31! Feel free to add it to your site :)
					</p>
				</div>
				<img
					src="/shares/88x31.png"
					alt="Eric Gu 88x31 button"
					width="88"
					height="31"
					class="share-button-image"
				/>
			</article>

			{presentationShares.map((share) => (
				<article class="share-card share-card-presentation">
					<div class="share-card-copy">
						<p class="share-category">Talks</p>
						<h2 class="share-title">{share.title}</h2>
						<p class="share-description">{share.description}</p>
					</div>
					<iframe
						src={share.file}
						title={share.title}
						loading="lazy"
						class="share-presentation"
					></iframe>
				</article>
			))}

			<article class="share-card share-card-stickers">
				<div class="share-card-copy">
					<p class="share-category">Signal Sticker Packs</p>
					<h2 class="share-title">Berkeley Dining</h2>
					<p class="share-description">
						<a href="https://signal.art/addstickers/#pack_id=0746a218f9230c96ee6f2adeb3dfe80e&pack_key=26115bcfc60a8e508d478af8e1a21abace603c87f7fc95d253ff4f51d198a111" target="_blank" rel="noopener noreferrer">
							Add to Signal
						</a>
					</p>
				</div>
				<img
					src="/shares/packs/berkeley-dining/croads.png"
					alt="Berkeley Dining sticker"
					class="sticker-preview"
				/>
				<details class="sticker-details">
					<summary>Show pack</summary>
					<div class="sticker-grid">
						{stickerPackImages.map((image) => (
							<img
								src={`/shares/packs/berkeley-dining/${image}`}
								alt=""
								loading="lazy"
							/>
						))}
					</div>
				</details>
			</article>
		</div>
	</div>
</RootLayout>

<style>
	.share-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.share-card {
		display: grid;
		align-items: center;
		gap: 2rem;
		border: 1px solid oklch(70% 0.025 248);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background: oklch(96% 0.012 248);
		box-shadow: 0 0.75rem 2rem oklch(23% 0.025 248 / 0.06);
	}

	.share-card-image {
		grid-template-columns: 1fr auto;
	}

	.share-card-presentation {
		grid-template-columns: minmax(12rem, 0.8fr) minmax(18rem, 1.2fr);
	}

	.share-card-stickers {
		grid-template-columns: minmax(0, 1fr) 8rem;
	}

	.share-card-copy {
		min-width: 0;
	}

	.share-category {
		margin: 0 0 0.5rem;
		color: oklch(42% 0.09 250);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.share-title {
		margin: 0;
		color: oklch(23% 0.025 248);
		font-size: 1.25rem;
		line-height: 1.25;
	}

	.share-description {
		margin: 0.75rem 0 0;
		color: oklch(38% 0.025 248);
		line-height: 1.6;
	}

	.share-description a {
		color: oklch(42% 0.09 250);
	}

	.share-button-image {
		width: min(11rem, 30vw);
		height: auto;
		image-rendering: pixelated;
	}

	.share-presentation {
		width: 100%;
		height: 16rem;
		border: 1px solid oklch(70% 0.025 248);
		border-radius: 0.5rem;
		background: oklch(91% 0.025 248);
	}

	.sticker-preview {
		width: 8rem;
		height: 8rem;
		object-fit: contain;
	}

	.sticker-details {
		grid-column: 1 / -1;
		border-top: 1px solid oklch(70% 0.025 248);
		padding-top: 1rem;
	}

	.sticker-details summary {
		color: oklch(42% 0.09 250);
		cursor: pointer;
		font-weight: 700;
	}

	.sticker-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	.sticker-grid img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: contain;
	}

	@media (max-width: 640px) {
		.share-card,
		.share-card-image,
		.share-card-presentation,
		.share-card-stickers {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.share-button-image,
		.sticker-preview {
			justify-self: start;
		}
	}
</style>
