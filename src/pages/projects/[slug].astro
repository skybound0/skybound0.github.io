---
import RootLayout from '../../layouts/RootLayout.astro';
import { getCollection, render } from 'astro:content';
import { getDimensionsFromAspectRatio } from '../../lib/image';
import CategoryList from '../../components/CategoryList.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id.replace(/\.md$/, '') },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectImages = project.data.images?.length ? project.data.images : project.data.image ? [project.data.image] : [];
const imageAspectRatio = project.data.imageAspectRatio || project.data.cardAspectRatio || '16 / 9';
const imageDimensions = getDimensionsFromAspectRatio(imageAspectRatio, 1600);
---

<RootLayout title={`${project.data.title} | Projects`} description={project.data.description || 'Project details'}>
	<div class="page-container">
		<a href="/projects" class="btn btn-ghost btn-sm -ml-3 mb-6 font-medium text-base-content/70 hover:text-primary">
			← All projects
		</a>

		<header class="page-header mb-10">
			<p class="meta md:col-span-12">{project.data.date}</p>
			<h1 class="page-title md:col-span-8">{project.data.title}</h1>
			{project.data.description && (
				<p class="page-subtitle md:col-span-4">{project.data.description}</p>
			)}
			<CategoryList categories={project.data.categories} class="md:col-span-12" />
		</header>

		{projectImages.length > 0 && (
			<div class="mb-12 space-y-4">
				{projectImages.map((image, index) => (
					<div class="relative w-full overflow-hidden rounded-box bg-base-200" style={`aspect-ratio: ${imageAspectRatio};`}>
						<img
							src={image}
							alt={`${project.data.title} image ${index + 1}`}
							width={imageDimensions.width}
							height={imageDimensions.height}
							loading={index === 0 ? 'eager' : 'lazy'}
							decoding="async"
							fetchpriority={index === 0 ? 'high' : 'auto'}
							sizes="(max-width: 768px) 100vw, 1100px"
							class="h-full w-full object-cover"
						/>
					</div>
				))}
			</div>
		)}

		<div class="grid gap-8 md:grid-cols-12">
			<article class="prose md:col-span-8 md:col-start-4">
				<Content />

				{project.data.list && project.data.list.length > 0 && (
					<ul>
						{project.data.list.map((item) => <li>{item}</li>)}
					</ul>
				)}
			</article>
		</div>
	</div>
</RootLayout>
